# FlowForge Community — Local Environment Template
# Copy to .env (`Copy-Item .env.example .env` in PowerShell) and customize before starting.
# Never commit a real .env file to version control.

# Primary durable PostgreSQL database connection (pgAdmin / localhost)
DATABASE_URL=postgresql+psycopg://flowforge:replace-with-strong-local-password@localhost:5432/flowforge_dev

# Master key for Fernet AES-128-CBC + HMAC-SHA256 credential encryption at rest.
# Generate a strong key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLOWFORGE_MASTER_KEY=flowforge-dev-only-insecure-master-key-change-in-prod

# Authentication & RBAC (set to true in production to require X-API-Key or Bearer token on all endpoints)
FLOWFORGE_REQUIRE_AUTH=false
FLOWFORGE_API_TOKEN=

# Network & SSRF Isolation (keep false in production; loopback/private/metadata IPs are blocked by default)
FLOWFORGE_ALLOW_PRIVATE_HTTP=false
FLOWFORGE_ALLOWED_HTTP_HOSTS=

# Sandboxed directory for File I/O nodes
FLOWFORGE_ALLOWED_FILE_DIR=./flowforge_data/files

# Execution limits
FLOWFORGE_MAX_EXECUTION_SECONDS=30.0
FLOWFORGE_CODE_TIMEOUT_SECONDS=5.0
FLOWFORGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
